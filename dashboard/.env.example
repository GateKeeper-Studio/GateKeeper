# ── Server-only (never exposed to the browser) ────────────────────────────────

# Base URL the SvelteKit server uses to reach the identity provider for ADMIN
# calls. The browser never sees this: admin requests go to /api/* on this origin
# and `src/routes/api/[...path]/+server.ts` forwards them with the bearer token.
IDP_BASE_URL=http://localhost:8080

# Signs the admin session cookie. At least 32 characters; generate with:
#   openssl rand -base64 48
# The server refuses to create or read a session without it.
SESSION_SECRET=

# ── Public (inlined into the browser bundle) ──────────────────────────────────

# Identity-provider base URL for the HOSTED END-USER AUTH FLOW under
# /auth/[clientId] — sign-in, sign-up, MFA, password reset. Those calls stay
# browser→IdP direct on purpose: proxying them would make every interactive login
# arrive wearing this server's IP, blinding the IdP's risk engine and collapsing
# its per-IP rate limit onto one key. They carry no long-lived credential.
#
# Usually the same host as IDP_BASE_URL, but as reachable from the browser.
PUBLIC_API_BASE_URL=http://localhost:8080

# Origin of the independently deployed public landing page and documentation.
PUBLIC_WEBSITE_BASE_URL=http://localhost:5174
