# The dashboard is a static single-page app served by the identity provider itself
# (server: UI_DIR). It calls the identity provider on its own origin, so it needs no
# API URL and holds no secret: the admin session is an httpOnly cookie the server
# sets. See server/docs/SERVING-THE-DASHBOARD-FROM-THE-SERVER.md.

# Origin of the independently deployed public landing page and documentation.
# Read at build time (it is baked into the static build).
PUBLIC_WEBSITE_BASE_URL=http://localhost:5174

# `npm run dev` only: where the Rust server listens (vite proxies the identity
# provider's paths to it). Defaults to http://localhost:8080.
# GATEKEEPER_SERVER_URL=http://localhost:8080
