# GateKeeper AngularJS public client — browser-only config (VITE_-prefixed values
# ship to the browser; NEVER put a client secret here — public clients have none).
VITE_GATEKEEPER_IDP_BASE_URL=http://localhost:8080
VITE_GATEKEEPER_AUTH_UI_BASE_URL=http://localhost:5173
VITE_GATEKEEPER_TENANT_ID=
VITE_GATEKEEPER_CLIENT_ID=
VITE_GATEKEEPER_REDIRECT_URI=http://localhost:5178/
VITE_GATEKEEPER_SCOPE=openid profile email
