# GateKeeper Next.js BFF — ALL values are server-only (no NEXT_PUBLIC_ prefix).
# The client secret and session secret never reach the browser.
IDP_BASE_URL=http://localhost:8080
AUTH_UI_BASE_URL=http://localhost:5173
OAUTH_TENANT_ID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5179/auth/callback
# `account` lets this app call the IdP `/me` API (profile, MFA). The OAuth client
# must have `account` in its allowed scopes, or it is silently dropped.
OAUTH_SCOPE=openid profile email account
# openssl rand -hex 32
SESSION_SECRET=
