# Public OAuth client settings. This app is a static browser-only SPA and uses
# Authorization Code + PKCE without a client secret.

VITE_GATEKEEPER_IDP_BASE_URL=http://localhost:8080
# The identity provider serves the hosted login UI, so sign-in goes to
# {VITE_GATEKEEPER_IDP_BASE_URL}/auth/{CLIENT_ID}/sign-in. Uncomment only for a login UI on another origin.
# VITE_GATEKEEPER_AUTH_UI_BASE_URL=
VITE_GATEKEEPER_TENANT_ID=
VITE_GATEKEEPER_CLIENT_ID=
VITE_GATEKEEPER_REDIRECT_URI=http://localhost:5174/
VITE_GATEKEEPER_SCOPE=openid profile email

