# ── Backend-for-Frontend (BFF) OAuth2/OIDC client configuration ──────────────
# All values here are SERVER-ONLY secrets. They are read via $env/dynamic/private
# and must never be exposed to the browser (do NOT prefix with PUBLIC_).

# Identity Provider (Rust) base URL — used for server→server /oauth/token and
# /oauth/userinfo calls.
IDP_BASE_URL=http://localhost:8080

# Dashboard hosted login UI base URL — where the user is redirected to sign in.
AUTH_UI_BASE_URL=http://localhost:3000

# The tenant + client this app is registered as. Create the client with
# ./scripts/register-client.sh <tenant_id> and paste the returned values here.
OAUTH_TENANT_ID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Must exactly match a redirect_uri registered on the client above.
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Space-separated OIDC scopes. "openid" is required to receive an id_token.
OAUTH_SCOPE=openid profile email

# Key used to encrypt the session cookie (AES-256-GCM). Use a long random value,
# e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-string
