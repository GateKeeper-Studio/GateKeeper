  "query": "\n          SELECT id, tenant_id, user_id, token_hash, attempts, consumed_at, expires_at, created_at\n          FROM email_verification_tokens\n          WHERE user_id = $1 AND consumed_at IS NULL\n          ORDER BY created_at DESC\n          LIMIT 1\n        ",
