  "db_name": "PostgreSQL",
  "query": "\n          SELECT g.id, g.tenant_id, g.name, g.description, g.created_at, g.updated_at\n          FROM \"groups\" g\n          JOIN group_members gm ON gm.group_id = g.id\n          WHERE gm.user_id = $1 AND g.tenant_id = $2\n          ORDER BY g.created_at DESC\n        ",
