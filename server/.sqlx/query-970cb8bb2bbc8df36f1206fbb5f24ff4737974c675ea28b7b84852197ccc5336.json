  "query": "\n          SELECT id, tenant_id, kid, algorithm, public_jwk::text as \"public_jwk!\",\n            private_key_encrypted, status, rotates_at, created_at\n          FROM signing_keys\n          WHERE tenant_id = $1 AND status IN ('active', 'retiring')\n          ORDER BY created_at DESC\n        ",
