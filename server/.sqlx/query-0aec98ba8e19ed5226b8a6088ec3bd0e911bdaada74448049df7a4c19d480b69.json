  "query": "SELECT id, tenant_id, block_type, ip_address, user_id, reason, source,\n                          expires_at, created_at, created_by\n                   FROM \"security_blocks\"\n                   WHERE tenant_id = $1 AND block_type = 'user' AND user_id = $2\n                     AND expires_at > $3\n                   ORDER BY expires_at DESC\n                   LIMIT 1",
