  "db_name": "PostgreSQL",
  "query": "\n          SELECT r.id, r.tenant_id, r.name, r.description, r.created_at, r.updated_at\n          FROM \"roles\" r\n          JOIN role_assignments ra ON ra.role_id = r.id\n          WHERE ra.user_id = $1 AND r.tenant_id = $2\n          ORDER BY r.created_at DESC\n        ",
