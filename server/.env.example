# Gatekeeper server configuration template.
#
# Copy to `.env` for local development. `.env` is gitignored — never commit real
# secrets. In production, prefer real environment variables over a file.
#
# Variables marked REQUIRED-IN-PROD are enforced at startup whenever APP_ENV is
# anything other than `development`: the process refuses to boot without them
# rather than silently falling back to a localhost default. See
# `src/infraestructure/config.rs`.

# ── Environment ───────────────────────────────────────────────────────────────
# `development` enables the localhost-friendly fallbacks below. Any other value
# (`staging`, `production`, …) turns on strict startup validation.
APP_ENV=development

# ── Core ──────────────────────────────────────────────────────────────────────
# REQUIRED always.
DATABASE_URL="postgres://gatekeeper:gatekeeper@localhost:5432/gatekeeper"
PORT=8080

# Connection pool. The right maximum is a property of the deployment: it must fit
# under the Postgres server's own max_connections once divided across replicas.
# Every authenticated request used to borrow a connection just to read signing
# keys; that is cached now, so the pool goes much further than it used to.
DATABASE_MAX_CONNECTIONS=10
# A floor of warm connections avoids paying TCP+TLS+auth on the first requests
# after an idle period. 0 keeps the previous behaviour.
DATABASE_MIN_CONNECTIONS=0
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# REQUIRED always. HS256 secret for platform-admin tokens AND the Argon2 pepper
# for platform-admin passwords. Minimum 32 characters outside development.
#   openssl rand -base64 48
JWT_SECRET="change-me-use-openssl-rand-base64-48"

# ── Public identity ───────────────────────────────────────────────────────────
# REQUIRED-IN-PROD. The public issuer URL pinned as the `iss` claim of every
# token and advertised at /.well-known/openid-configuration. Getting this wrong
# breaks discovery and every downstream verifier, so it is not guessed.
OAUTH_ISSUER="http://localhost:8080"

# REQUIRED-IN-PROD. Comma-separated browser origins allowed to call this API.
# Must include the dashboard origin. An empty value means "any origin" and is
# rejected outside development.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# REQUIRED-IN-PROD. Base URL of the hosted login UI (dashboard). Password-reset
# emails link back to its /auth/{client_id}/change-password page.
AUTH_UI_BASE_URL="http://localhost:5173"

# ── Admin surface ─────────────────────────────────────────────────────────────
# Enforce bearer auth + RBAC on admin routes. `false` degrades the admin guard to
# best-effort (a transition aid) and is refused outside development. Bootstrap the
# first admin with:
#   cargo run --bin create_admin -- <email> <password>
REQUIRE_ADMIN_AUTH=true

# ── Secrets at rest ───────────────────────────────────────────────────────────
# REQUIRED-IN-PROD. 32-byte AES-256-GCM master key (base64 or hex) encrypting
# stored SMTP passwords, webhook signing secrets, TOTP seeds and tenant signing
# keys. Must be independent of JWT_SECRET so that leaking one does not compromise
# the other.
#   openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=""

# ── WebAuthn / passkeys ───────────────────────────────────────────────────────
# REQUIRED-IN-PROD (rp_origin). The rp_id/origin must match the host the browser
# shows during the ceremony. Extra first-party origins running ceremonies (e.g. a
# BFF client's /account/security page) go in ADDITIONAL_ORIGINS; all of them must
# share the rp_id's effective domain.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_ORIGIN="http://localhost:5173"
WEBAUTHN_ADDITIONAL_ORIGINS="http://localhost:5174"

# ── Tokens ────────────────────────────────────────────────────────────────────
# Grace window (seconds) in which a just-rotated refresh token presented again is
# reissued instead of revoking the family — absorbs concurrent-refresh races.
REFRESH_REUSE_LEEWAY_SECONDS=10

# ── Legal policy versions ─────────────────────────────────────────────────────
# Bumping a version forces re-acceptance. Sourced from env so it can be rolled
# without a deploy.
POLICY_TERMS_VERSION=1
POLICY_PRIVACY_VERSION=1

# ── GeoIP enrichment (optional) ───────────────────────────────────────────────
# Unset ⇒ enrichment disabled: a no-op resolver is wired and the geo risk rules
# (new country, impossible travel) never fire. The login flow is unaffected.
# Download GeoLite2-City.mmdb (and optionally GeoLite2-ASN.mmdb) from MaxMind.
# GEOIP_CITY_DB_PATH="/var/lib/geoip/GeoLite2-City.mmdb"
# GEOIP_ASN_DB_PATH="/var/lib/geoip/GeoLite2-ASN.mmdb"

# ── Outbound webhooks ─────────────────────────────────────────────────────────
# Disabling the dispatcher does not lose events; the outbox keeps filling.
WEBHOOKS_ENABLED=true
WEBHOOK_POLL_INTERVAL_SECONDS=5
WEBHOOK_BATCH_SIZE=100
WEBHOOK_TIMEOUT_SECONDS=10

# SECURITY: allows webhook URLs pointing at private/loopback addresses. Dev and
# self-hosted single-network deployments ONLY — enabled in a cloud environment, a
# tenant admin can point a webhook at the instance metadata endpoint and read your
# IAM credentials. See docs/FLOWS-WEBHOOKS.md §7.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ── Caching ───────────────────────────────────────────────────────────────────
# How long a tenant's published signing keys stay cached in process. This bounds
# only how long a RETIRED key could still be accepted — a NEWLY published key is
# picked up immediately, because the auth middleware drops the entry and refetches
# when a token fails to verify against it.
SIGNING_KEY_CACHE_TTL_SECONDS=60

# ── Data retention ────────────────────────────────────────────────────────────
# Background purge of expired sessions, tokens, codes, MFA challenges and IP
# blocks. Disabling it means those rows accumulate forever unless an external job
# removes them. The audit log is never touched by this — it has its own, longer
# retention floor. See docs/compliance/retention-schedule.md.
RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_INTERVAL_SECONDS=3600

# ── Logging ───────────────────────────────────────────────────────────────────
# tracing-subscriber EnvFilter directive.
RUST_LOG=info

# `json` or `text`. Defaults to json whenever APP_ENV is not development, so a
# production deployment is machine-parseable without anyone remembering to set it.
# Every line carries the request_id from the x-request-id correlation span.
LOG_FORMAT=text
