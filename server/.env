JWT_SECRET="my-ultimate-jwt-secret"
PORT='8080'

DATABASE_URL="postgres://gatekeeper:gatekeeper@localhost:5432/gatekeeper"

# Enforce bearer-auth + RBAC on admin routes (WI-08). Admins sign in at the
# dashboard's /login page (POST /admin/login) and the dashboard replays the issued
# token on every admin call. Bootstrap the first admin with:
#   cargo run --bin create_admin -- <email> <password>
REQUIRE_ADMIN_AUTH=true

# Origins allowed to call the API cross-origin (comma-separated). Must include the
# dashboard origin so its fetch calls are not blocked by CORS.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Base URL of the hosted login UI (dashboard). Password-reset emails link back to
# its /auth/{client_id}/change-password page. Defaults to http://localhost:5173.
AUTH_UI_BASE_URL="http://localhost:5173"

# Extra browser origins allowed to run WebAuthn ceremonies besides the auth UI
# (comma-separated). The BFF client enrolls passkeys from its own origin on
# /account/security, so it must be allow-listed here. All origins must share the
# rp_id's effective domain (localhost in dev).
WEBAUTHN_ADDITIONAL_ORIGINS="http://localhost:5174"

# 32-byte AES-256-GCM key (base64 or hex) used to encrypt stored SMTP provider
# passwords. If unset, derived from JWT_SECRET via SHA-256 (dev only). Generate a
# real one with: openssl rand -base64 32
# EMAIL_ENCRYPTION_KEY=""