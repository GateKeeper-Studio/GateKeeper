{
  "name": "@gatekeeper/angular",
  "version": "0.0.1",
  "type": "module",
  "description": "Angular (2+) bindings for the GateKeeper public OAuth (Auth Code + PKCE) SPA client.",
  "main": "./src/public-api.ts",
